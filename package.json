{
  "name": "light-shadow-workshop",
  "private": true,
  "version": "1.0.0",
  "description": "光影工坊：窗棂之间 —— 三维空间投影益智游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-levels.ts",
    "verify:window": "tsx scripts/verify-window.ts",
    "verify:all": "npm run verify && npm run verify:window",
    "verify:prod": "node scripts/check-prod-hook.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "evidence": "node scripts/capture-evidence.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.169.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
